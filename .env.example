# Copy to .env and fill in locally. On Vercel, set these in Settings → Environment Variables.
# Never commit real values.

# Port for local runs only (npm start); Vercel does not use it
PORT=

# development, test or production
NODE_ENV=

# MongoDB Atlas connection string
MONGODB_URI=

# Secret used to sign and verify JWT bearer tokens: at least 32 random characters.
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=

# Optional. Browser origins allowed to call the API (comma-separated, exact), e.g. https://dashboard.example.
# Empty means none: meters and server-side clients are not affected by CORS.
CORS_ORIGINS=

# Optional. Failed POST /auth/tokens attempts allowed per client address per 15 minutes (default 10).
AUTH_TOKEN_MAX_FAILURES=
