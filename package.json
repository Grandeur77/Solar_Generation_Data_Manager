{
  "name": "solar-generation-api",
  "version": "0.1.0",
  "description": "Real-Time Solar Generation Data API for the Sri Lanka Sustainable Energy Authority (NB6007CEM coursework)",
  "private": true,
  "type": "commonjs",
  "main": "src/server.js",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "test": "node --experimental-vm-modules node_modules/jest/bin/jest.js",
    "setup-db": "node scripts/setup-db.js",
    "generate-hierarchy": "node scripts/generate-hierarchy.js",
    "seed": "node scripts/seed.js",
    "verify-seed": "node scripts/verify-seed.js",
    "smoke": "node scripts/smoke-test.js"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "dotenv": "^18.0.5",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.1",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^9.11.0"
  },
  "devDependencies": {
    "jest": "^30.5.2",
    "mongodb-memory-server": "^11.3.0",
    "supertest": "^7.3.1"
  },
  "jest": {
    "testEnvironment": "node",
    "testTimeout": 10000,
    "globalSetup": "<rootDir>/tests/setup/global-setup.js",
    "globalTeardown": "<rootDir>/tests/setup/global-teardown.js"
  }
}
