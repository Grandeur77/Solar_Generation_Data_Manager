# Dependencies (reinstalled from package-lock.json with npm ci)
node_modules/

# Environment files hold real secrets; only the template is committed
.env
.env.*
!.env.example

# Test coverage output (regenerated by npm test)
coverage/

# Credential and key files (e.g. generated device secrets). Data files only, so source code is never hidden
*credentials*.json
*credentials*.txt
*secrets*.json
*secrets*.txt
*.pem
*.key

# Logs
npm-debug.log*
*.log

# OS files
.DS_Store
